# Application Settings
APP_NAME=SwasthyaMitra
APP_VERSION=0.1.0
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production

# Database & Server
DATABASE_URL=sqlite:///./swasthya_mitra.db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# SMS & Notification Gateway Settings
# Options: 'simulator' (default testing), 'fast2sms' (India), 'twilio' (Global)
SMS_ENABLED=True
SMS_PROVIDER=simulator

# Fast2SMS Credentials (For Indian numbers: +91)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio Credentials (Global numbers)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

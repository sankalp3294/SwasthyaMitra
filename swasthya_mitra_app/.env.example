# Environment Configuration - Copy to .env

# Database
DATABASE_URL=mysql+pymysql://swasthya_user:swasthya_password@mysql:3306/swasthya_mitra
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=swasthya_user
MYSQL_PASSWORD=swasthya_password
MYSQL_DATABASE=swasthya_mitra

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
BACKEND_RELOAD=true
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# Frontend
REACT_APP_API_URL=http://localhost:8080
REACT_APP_API_TIMEOUT=30000

# Redis (Optional)
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO

# OTP Configuration
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=3

# AI/NLP Service Configuration
AI_SERVICE_TIMEOUT=30
INTENT_CLASSIFICATION_THRESHOLD=0.7

# Analytics
ANALYTICS_ENABLED=true
CLUSTER_DETECTION_ENABLED=true
ZONE_BASELINE_PERIOD_DAYS=30

# Notification (Future Phase)
NOTIFICATION_SERVICE_URL=
SMS_PROVIDER_API_KEY=

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# Hospital Configuration
DEFAULT_HOSPITAL_SEARCH_RADIUS_KM=10

# ASHA Configuration
ASHA_ESCALATION_AFTER_NO_SHOW=2
